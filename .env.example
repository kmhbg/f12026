# Namn som visas i appen
APP_NAME=F1 Betting
# Säsong som bettas (standard: innevarande år)
SEASON_YEAR=2026
# Insats per racebet (kr)
STAKE_PER_BET=50
# Publik adress, används i inbjudningslänkar (utan / på slutet)
PUBLIC_URL=http://localhost:3000
# Sätt till true (eller antal proxy-hopp) om appen ligger bakom en reverse proxy
# som terminerar HTTPS, så att cookies markeras Secure.
TRUST_PROXY=
# Kommaseparerade origins som får anropa API:et med cookies (t.ex. mobilappar).
# Lämna tomt om allt körs från samma adress.
CORS_ORIGINS=
# Port på värden
PORT=3000

# Valfritt: import av bets från t.ex. WhatsApp/n8n (header X-Import-Token).
# Generera med: openssl rand -hex 32
F1_IMPORT_TOKEN=

# Valfritt: OpenF1-konto för livedata under pågående pass.
OPENF1_USERNAME=
OPENF1_PASSWORD=
