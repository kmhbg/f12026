[Unit]
Description=F1 Betting 2026 Node.js app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/f1-betting-2026
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=CACHE_DIR=data/cache
# OpenF1 MQTT (valfritt, via drop-in override – aldrig lösenord i denna fil):
# Environment=OPENF1_USERNAME=din@email.com
# Environment=OPENF1_PASSWORD=...

[Install]
WantedBy=multi-user.target
